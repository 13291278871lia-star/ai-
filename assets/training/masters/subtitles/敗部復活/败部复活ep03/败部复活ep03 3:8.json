      "text": "好,好,好,好,好,好,好,好,好,好,好,"
    },
    {
      "start": 131.99,
      "end": 134.82,
      "text": "好,好,好,好,好,好,好,好,好,好,好,"
    },
    {
      "start": 134.82,
      "end": 135.47,
      "text": "好,好,好,好,好,好,好,好,好,好,好,"
    },
    {
      "start": 135.47,
      "end": 136.12,
      "text": "好,好,好,好,好,好,好,好,好,好,好,"
    },
    {
      "start": 136.12,
