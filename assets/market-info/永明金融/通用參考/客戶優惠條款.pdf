   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Beige ceo interior with laptop on work desk, side view chairs on hardwood floor. Consulting corner with shelf and decoration, panoramic window on countryside. 3D rendering</rdf:li>
